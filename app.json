{
  "expo": {
    "name": "PoliçeAsistan",
    "slug": "policeasistan-mobile",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "policeasistan",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.policeasistan.mobile",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.policeasistan.mobile",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-image",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Poliçe belgelerini ve hasar fotoğraflarını eklemek için fotoğraflarınıza erişim gerekir.",
          "cameraPermission": "Poliçe belgelerini ve hasar fotoğraflarını çekmek için kameraya erişim gerekir.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3304bbef-7523-4811-872e-342966eda70c"
      }
    },
    "owner": "policeasistan-app"
  }
}